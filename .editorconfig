# EditorConfig is awesome: https://EditorConfig.org

root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.bat]
end_of_line = crlf

[*.ps1]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false

[*.{json,yml,yaml,toml}]
indent_size = 2
