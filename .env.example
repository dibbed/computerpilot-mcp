# ComputerPilot MCP - Environment Configuration Example
# Copy this file to .env or set variables directly in your environment.
# Never commit real credentials or secret keys to version control.

# Tool catalog profile: minimal, coding, git, testing, desktop, browser, operations, or full.
# Omitted/default `full` preserves the complete backward-compatible catalog.
# MCP_TOOL_PROFILE=full

# Execution mode: 'tunnel' (default) or 'local-http'
# MCP_START_MODE=tunnel

# OpenAI Secure Tunnel profile name (defaults to auto-detected profile or 'default')
# MCP_TUNNEL_PROFILE=default

# Secure Tunnel runtime update policy.
# Normal startup checks the official openai/tunnel-client release channel at most once per 24 hours.
# The verified release is installed under .agent_state/tunnel-runtime and reused as the managed offline cache.
# MCP_TUNNEL_AUTO_UPDATE=1
# MCP_TUNNEL_UPDATE_INTERVAL_HOURS=24
# MCP_TUNNEL_VERSION=v0.0.14
# MCP_TUNNEL_UPDATE_REQUIRED=0
# MCP_TUNNEL_ALLOW_PRERELEASE=0
# MCP_TUNNEL_CLIENT_BIN=C:\absolute\path\to\tunnel-client-runtime-cloudflared.exe

# Control-plane API key for Tunnel mode (alternatively store in .secrets/control_plane_api_key.txt)
# CONTROL_PLANE_API_KEY=your-control-plane-api-key-here
# Bounded Python project metadata cache (Phase C1)
# MCP_AST_CACHE_MAX_FILES=10000
# MCP_AST_CACHE_MAX_BYTES=67108864

# Bounded disk-backed search snapshots (Phase C4)
# MCP_SEARCH_SNAPSHOT_TTL_SEC=180
# MCP_SEARCH_SNAPSHOT_MAX_BYTES=134217728
# MCP_SEARCH_SNAPSHOT_MAX_COUNT=32

# Shared browser-pool idle reclamation + bounded session/pool budgets (Phase D + Phase F5 / v0.0.17)
# MCP_BROWSER_IDLE_SEC=900
# MCP_BROWSER_POOL_IDLE_SEC=120
# MCP_BROWSER_MAX_SESSIONS=20
# MCP_BROWSER_MAX_POOLS=6

# Multimodal screenshot delivery (v0.0.18)
# auto sends the original image when it is small enough and a bounded JPEG preview otherwise.
# MCP_VISION_MAX_BYTES=8388608
# MCP_VISION_JPEG_QUALITY=88

# Durable-job admission control (Phase E2 / v0.0.16)
# Conservative default; raise only after benchmarking your host.
# MCP_MAX_RUNNING_JOBS=4

# Supervisor mutation drain before runtime restart/stop (Phase E4 / v0.0.16)
# Normal user restart/stop deadline and shorter watchdog best-effort deadline.
# MCP_SUPERVISOR_DRAIN_SEC=15
# MCP_SUPERVISOR_WATCHDOG_DRAIN_SEC=2

# Windows Job Object process-tree ownership (Phase E5 / v0.0.16)
# Enabled by default after the Windows integration/benchmark gate; set 0 only as an emergency compatibility fallback.
# MCP_WINDOWS_JOB_OBJECTS=1

# Bounded audit batching + rotation/retention (Phase F1 / v0.0.17)
# Non-destructive metadata batches asynchronously; destructive events fsync before returning.
# MCP_AUDIT_BATCH_SIZE=64
# MCP_AUDIT_FLUSH_MS=50
# MCP_AUDIT_QUEUE_MAX=2048
# Active audit.jsonl rotates at 8 MiB; keep 5 rotated files plus the active file.
# MCP_AUDIT_MAX_FILE_BYTES=8388608
# MCP_AUDIT_KEEP_FILES=5

# Recoverable backup retention (Phase F2 / v0.0.17)
# Set a limit to 0 to disable that retention dimension.
# MCP_BACKUP_MAX_BYTES=268435456
# MCP_BACKUP_MAX_AGE_DAYS=30
# Background/coalesced cleanup scans no more often than this interval.
# MCP_BACKUP_CLEANUP_INTERVAL_SEC=5

# Disk-backed delivery artifact retention (Phase F3 / v0.0.17)
# Set an age/count/byte limit to 0 to disable that retention dimension.
# MCP_ARTIFACT_MAX_BYTES=536870912
# MCP_ARTIFACT_MAX_AGE_HOURS=168
# MCP_ARTIFACT_MAX_COUNT=512
# MCP_ARTIFACT_CLEANUP_INTERVAL_SEC=5

# Terminal durable-job history/output retention (Phase F3 / v0.0.17)
# Queued/running/orphaned jobs are never pruned; 0 disables the matching terminal-history limit.
# MCP_JOB_HISTORY_MAX_AGE_DAYS=30
# MCP_JOB_HISTORY_MAX_COUNT=1000
# MCP_JOB_HISTORY_MAX_BYTES=1073741824
# MCP_JOB_HISTORY_CLEANUP_INTERVAL_SEC=30

# Durable workflow history retention and health pressure (v0.2.5)
# Only safe terminal completed/cancelled history is eligible for pruning.
# Active leases and unresolved uncertain/reconciling/unresolvable operation evidence are protected.
# Set age/count to 0 to disable that retention dimension.
# MCP_WORKFLOW_HISTORY_MAX_COUNT=1000
# MCP_WORKFLOW_HISTORY_MAX_AGE_DAYS=30
# MCP_WORKFLOW_DB_WARN_BYTES=268435456
# MCP_WORKFLOW_CLEANUP_INTERVAL_SEC=300
