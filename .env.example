# Ali Windows Agent MCP - Environment Configuration Example
# Copy this file to .env or set variables directly in your environment.
# Never commit real credentials or secret keys to version control.

# Execution mode: 'tunnel' (default) or 'local-http'
# MCP_START_MODE=tunnel

# OpenAI Secure Tunnel profile name (defaults to auto-detected profile or 'default')
# MCP_TUNNEL_PROFILE=default

# Control-plane API key for Tunnel mode (alternatively store in .secrets/control_plane_api_key.txt)
# CONTROL_PLANE_API_KEY=your-control-plane-api-key-here
# Bounded Python project metadata cache (Phase C1)
# MCP_AST_CACHE_MAX_FILES=1024
# MCP_AST_CACHE_MAX_BYTES=67108864
