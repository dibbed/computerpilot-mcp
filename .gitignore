# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Secrets and local credentials (CRITICAL: NEVER COMMIT)
.secrets/
.env
.env.*
!.env.example

# Runtime caches and test artifacts
.pytest_cache/
.pytest-tmp/
.pytest-tmp*/
.hypothesis/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.pytype/
.pyre/
.coverage
.coverage.*
coverage.xml
htmlcov/
playwright-report/
test-results/

# Agent local state, logs, and generated artifacts
.agent_state/
.playwright-cli/
output/
graphify-out/
*.log

# Project memory (persisted local user/project data)
memory/*.json
!memory/*.example.json

# Local unversioned/experimental tunnel runtime downloads

# Local development workflows and temporary documentation
docs/superpowers/
docs/roadmap/
tunnel-client-runtime*

# Local SQLite databases and write-ahead logs
# Also ignore rollback-journal variants created by non-WAL SQLite connections.
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal
*.db
*.db-wal
*.db-shm
*.db-journal

# Python / package-manager build artifacts
build/
dist/
*.egg
*.egg-info/
node_modules/
.pnpm-store/

# Editor and OS artifacts
.idea/
.vscode/
*.swp
*.swo
*~
*.bak
Thumbs.db
[Dd]esktop.ini
.DS_Store
